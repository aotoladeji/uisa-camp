# ─── Server ───────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Database ─────────────────────────────────
# Local SQLite (development)
DB_PATH=./db/uisa_camp.db

# Remote Turso (production - use one OR the other, not both)
# DATABASE_URL=libsql://your-db-name.turso.io?authToken=your-token
# LIBSQL_TOKEN=your-token (if required by your Turso setup)

# ─── JWT ──────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# ─── File Uploads (Cloudinary) ─────────────────
CLOUDINARY_CLOUD_NAME=djmo3lw8k
CLOUDINARY_API_KEY=451185663939159
CLOUDINARY_API_SECRET=Mu9naMEgZu3LN4uqPs2nXqElekA
MAX_FILE_SIZE_MB=5

# ─── Email (Nodemailer) ───────────────────────
